# =============================================================================
# AI-Watcher Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit your .env file to version control!

# -----------------------------------------------------------------------------
# REQUIRED VARIABLES
# These must be set for the core functionality to work
# -----------------------------------------------------------------------------

# OpenAI API Key
# Required for CrewAI agents and LLM-powered analysis
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Serper API Key
# Required for web search functionality via SerperDevTool
# Get your key at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Mailgun API Key
# Required for sending email reports via Mailgun
# Get your key at: https://app.mailgun.com/
MAILGUN_API=your_mailgun_api_key_here

# Mailgun Domain
# The domain configured in your Mailgun account for sending emails
# Example: mail.yourdomain.com or sandbox123.mailgun.org
MAILGUN_DOMAIN=your_mailgun_domain_here

# Email Recipients
# Comma-separated list of email addresses to receive reports
# Example: user1@example.com,user2@example.com
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Email From Address
# The sender address for outgoing reports
# Must be authorized in your Mailgun domain settings
EMAIL_FROM=AI Watcher <postmaster@your_mailgun_domain.com>

# -----------------------------------------------------------------------------
# OPTIONAL VARIABLES
# Enable additional features and data sources
# -----------------------------------------------------------------------------

# GitHub Personal Access Token
# Enables enhanced GitHub repository analysis (stars, commits, languages)
# Without this, GitHub metadata features will be limited
# Get your token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Twitter/X Bearer Token
# Enables social sentiment analysis from Twitter/X
# Required for SocialSentimentAnalyzer Twitter functionality
# Get your token at: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API Credentials
# Enables social sentiment analysis from Reddit
# Required for SocialSentimentAnalyzer Reddit functionality
# Get your credentials at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Alpha Vantage API Key
# Enables stock price tracking for AI companies mentioned in news
# Get your free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Finnhub API Key
# Alternative stock data provider (used if Alpha Vantage is not set)
# Get your free key at: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# - The application will work with only the required variables, but optional
#   variables enable enhanced features like social sentiment and stock tracking.
# - API rate limits apply to most services. Consider upgrading to paid tiers
#   for production use with high-frequency report generation.
# - For Mailgun sandbox domains, you must verify recipient emails first.
